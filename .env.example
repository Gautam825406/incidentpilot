# Backend
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DATABASE_URL=sqlite:///./incidentpilot.db
JWT_SECRET=change-me-in-production
# Phase 2 — Prometheus (optional; leave empty to disable)
PROMETHEUS_URL=
PROMETHEUS_AUTH_TOKEN=
PROMETHEUS_TIMEOUT=10.0
# Grafana (optional; dashboards is a JSON object mapping service -> dashboard path)
GRAFANA_URL=
GRAFANA_DASHBOARDS=
# Phase 4 — real log providers (optional; leave empty to disable).
# Elasticsearch takes precedence when both are set.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=logs-*
OPENSEARCH_URL=
OPENSEARCH_AUTH=
OPENSEARCH_INDEX=logs-*
# Phase 8 — optional shared secret for /api/webhooks/alert (X-Alert-Token header).
# Leave empty to keep the demo behaviour (webhook open).
ALERT_WEBHOOK_SECRET=
# Frontend (set at build/deploy time)
VITE_API_URL=http://localhost:8000
