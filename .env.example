# Backend
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Postgres is the PRIMARY database path. SQLite below is the local/demo
# fallback only — set a Postgres URL for any shared/production deployment
# (Neon/Supabase free tier, or the compose `postgres` service):
#   DATABASE_URL=postgresql://user:password@host:5432/incidentpilot
DATABASE_URL=sqlite:///./incidentpilot.db
# JWT secret: the app REFUSES TO START in live mode (GROQ_API_KEY set) if
# this is still the demo default. Set a strong random value in production.
JWT_SECRET=change-me-in-production
# CORS allow-list (comma-separated). Default covers local dev + the
# production frontend; set "*" only deliberately.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://incidentpilot-ten.vercel.app
# Rate limiting (in-memory sliding window, per IP). Set
# RATE_LIMIT_ENABLED=false to disable (e.g. behind a proxy that
# rate-limits already).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_WEBHOOK_PER_MINUTE=60
# Phase 2 — Prometheus (optional; leave empty to disable)
PROMETHEUS_URL=
PROMETHEUS_AUTH_TOKEN=
PROMETHEUS_TIMEOUT=10.0
# Grafana (optional; dashboards is a JSON object mapping service -> dashboard path)
GRAFANA_URL=
GRAFANA_DASHBOARDS=
# Phase 4 — real log providers (optional; leave empty to disable).
# Elasticsearch takes precedence when both are set.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=logs-*
OPENSEARCH_URL=
OPENSEARCH_AUTH=
OPENSEARCH_INDEX=logs-*
# Phase 8 — optional shared secret for /api/webhooks/alert (X-Alert-Token header).
# Leave empty to keep the demo behaviour (webhook open).
ALERT_WEBHOOK_SECRET=
# Phase 3 — Jira (optional; leave empty to disable). The API token is sent
# only in the Authorization header and is never logged or returned.
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_TIMEOUT=10.0
# Phase 3 — Slack incoming webhook (optional; leave empty to disable).
# The webhook URL is only ever POSTed to and is never logged or returned.
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=
SLACK_TIMEOUT=10.0
# Phase 7 — per-org credential encryption key (Fernet, base64 urlsafe
# 32-byte key; generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
# REQUIRED in production: without it, per-org integration secrets are
# encrypted with an ephemeral key that does not survive a restart.
CREDENTIALS_ENCRYPTION_KEY=
# Frontend (set at build/deploy time)
VITE_API_URL=http://localhost:8000
